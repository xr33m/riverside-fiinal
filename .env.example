# Google Maps JavaScript API key, used by components/ux/LocalProjectMap.tsx.
# Needs the "Maps JavaScript API" enabled in Google Cloud Console. Must be
# NEXT_PUBLIC_-prefixed since it's read in the browser (restrict it to your
# domain(s) in the Cloud Console, not by keeping it secret).
# Without this set, LocalProjectMap falls back to a key-less embedded map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Formspree endpoint the contact form (app/api/contact/route.ts) forwards
# validated submissions to, so a real inquiry reaches an inbox instead of
# only being logged server-side. Optional — defaults to the endpoint below
# if unset.
FORMSPREE_ENDPOINT=https://formspree.io/f/myeyvqzd
